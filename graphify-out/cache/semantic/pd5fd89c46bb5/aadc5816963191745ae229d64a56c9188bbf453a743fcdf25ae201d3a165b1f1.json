{"nodes": [{"id": "docs_frontend_feature_oriented_architecture", "label": "Feature-Oriented Frontend Architecture", "file_type": "rationale", "source_file": "docs/FRONTEND.md", "source_location": "L3-L16", "rationale": "Components render, hooks orchestrate, services talk to Supabase, React Query owns server state. Business logic never lives in a UI component, so a component can be moved or restyled without touching data flow.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_folder_structure", "label": "src Folder Structure", "file_type": "concept", "source_file": "docs/FRONTEND.md", "source_location": "L19-L203", "rationale": "app / pages / layouts / components / hooks / services / providers / constants / types / utils, each with a single stated responsibility; utils in particular must have no React dependencies so it stays pure and testable.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_react_query_source_of_truth", "label": "React Query As Single Source Of Server State", "file_type": "rationale", "source_file": "docs/FRONTEND.md", "source_location": "L205-L235", "rationale": "Server state is never duplicated into Context and global stores are avoided; local state is reserved for modal open, selected item and input fields. Two copies of server state is the bug this rule prevents.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_component_rules", "label": "One-Thing Component Rule", "file_type": "rationale", "source_file": "docs/FRONTEND.md", "source_location": "L239-L257", "rationale": "A TodoCard should not fetch data, call Supabase, know routing or manage global state \u2014 it only renders and receives props.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_routing", "label": "Public And Private Route Map", "file_type": "concept", "source_file": "docs/FRONTEND.md", "source_location": "L321-L345", "rationale": "Public: /login, /register, /forgot-password. Private: /dashboard, /boards, /boards/:boardId, /profile, /settings.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_form_contract", "label": "Form Contract", "file_type": "concept", "source_file": "docs/FRONTEND.md", "source_location": "L307-L318", "rationale": "Every form validates, trims inputs, shows a loading state and shows success/error feedback.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_performance_guidelines", "label": "Frontend Performance Guidelines", "file_type": "rationale", "source_file": "docs/FRONTEND.md", "source_location": "L361-L369", "rationale": "Avoid unnecessary renders, memoize only when beneficial, virtualize long lists if necessary, lazy-load large routes. Memoization is conditional on benefit rather than applied by default.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_isolated_feature_folders", "label": "Isolated Feature Folders", "file_type": "rationale", "source_file": "docs/FRONTEND.md", "source_location": "L387-L403", "rationale": "services/comments, services/attachments, services/notifications and services/members all follow the same api + hooks shape, so the architecture stays predictable regardless of project size.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_frontend_feature_oriented_architecture", "target": "docs_api_layered_request_flow", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/FRONTEND.md", "source_location": "L3-L16", "weight": 1.0}, {"source": "docs_frontend_feature_oriented_architecture", "target": "docs_frontend_folder_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sourc