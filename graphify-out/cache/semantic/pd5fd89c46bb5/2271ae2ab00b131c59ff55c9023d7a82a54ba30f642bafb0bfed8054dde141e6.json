88", "weight": 1.0}, {"source": "docs_api_api_layer", "target": "src_services_columns_columnsapi_getcolumns", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/API.md", "source_location": "L79-L88", "weight": 1.0}, {"source": "docs_api_api_layer", "target": "src_services_members_membersapi_fetchboardmembers", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/API.md", "source_location": "L79-L88", "weight": 1.0}, {"source": "docs_api_api_layer", "target": "src_services_todos_todoapi_addtodo", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/API.md", "source_location": "L79-L88", "weight": 1.0}, {"source": "docs_api_naming_conventions", "target": "src_services_boards_boardsapi_createboard", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/API.md", "source_location": "L295-L341", "weight": 1.0}, {"source": "docs_api_naming_conventions", "target": "src_services_boards_boardsapi_deleteboard", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/API.md", "source_location": "L295-L341", "weight": 1.0}, {"source": "docs_api_hooks_layer", "target": "src_services_todos_usetodos_usetodos", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/API.md", "source_location": "L53-L66", "weight": 1.0}, {"source": "docs_api_filtering_in_hooks", "target": "docs_api_hooks_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L243-L265", "weight": 1.0}, {"source": "docs_api_validation_policy", "target": "docs_architecture_rls_enforcement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/API.md", "source_location": "L385-L391", "weight": 1.0}, {"source": "do