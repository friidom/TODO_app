# Copy to .env:  cp .env.example .env
# .env is gitignored.
#
# Docker does not need this file. `docker compose up --build` works from a bare
# clone — docker-compose.yml carries a working default for everything below.


# --- Frontend, local development only (npm run dev) -------------------------
#
# Vite inlines these at build time, so changing one means restarting the dev
# server. Docker ignores them entirely and passes its own build arguments.

VITE_API_URL=http://localhost:4000/api/v1

# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY used to live here. They
# are gone: realtime moved to the API's Socket.IO server (B9), attachments and
# avatars to MinIO (B10), and with them the last importer of the Supabase
# client. VITE_API_URL is now the only variable the frontend reads.


# --- Docker Compose overrides -----------------------------------------------
#
# Both are safe to leave unset for a local demo; the defaults below are what
# docker-compose.yml already uses. Set them for anything a browser other than
# your own can reach.

# POSTGRES_PASSWORD=postgres

# At least 32 characters. Generate one with:  openssl rand -base64 48
# JWT_SECRET=docker-demo-secret-change-me-at-least-32-chars
