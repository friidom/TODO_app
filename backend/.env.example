# Copy to .env:  cp .env.example .env
# .env is gitignored. This file lists what the backend reads — keep them in step.
#
# docker-compose.yml also passes .env into the backend container (env_file), so
# it must be valid Compose env-file syntax: KEY=VALUE, blank lines, and only
# `#` comments. A `//` comment is NOT ignored — Compose refuses the whole file
# with `unexpected character "/" in variable name`, and every variable in it
# silently goes missing. Node's dotenv tolerates one, which is what makes this
# fail in Docker only.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required. The backend refuses to start without it.
# Percent-encode reserved characters in the password: @ becomes %40, : becomes
# %3A, / becomes %2F, # becomes %23, ? becomes %3F, % becomes %25.
DATABASE_URL=postgresql://postgres:p%40ssword@localhost:5432/todo_app

# Required by `npm run test:integration` only; the server never reads it.
# Must point at a SEPARATE database — the suite truncates every table between
# files. Create it with the same locale as todo_app so ORDER BY agrees.
TEST_DATABASE_URL=postgresql://postgres:p%40ssword@localhost:5432/todo_app_test


# --- B5, authentication -----------------------------------------------------

# Required, at least 32 characters. Generate with:  openssl rand -base64 48
# Changing it invalidates every access token in flight; refresh tokens survive,
# because those are database rows rather than signatures.
JWT_SECRET=

# Access tokens are short because they cannot be revoked; the refresh token is
# the part that is revocable, and it is the one that lasts.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# The refresh cookie. COOKIE_SECURE must be true in production — the process
# refuses to start otherwise. SameSite=none additionally requires it, because
# browsers drop that pair.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Where password-reset links point, i.e. the frontend.
APP_URL=http://localhost:5173

# console prints the mail (reset links included) to the server log and is
# refused in production. smtp requires SMTP_HOST.
MAIL_DRIVER=console
MAIL_FROM=TODO App <no-reply@todo.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# false marks every new account verified at registration, which is only
# acceptable while there is no SMTP to verify with. Production refuses to start
# with it off.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- OAuth: "Continue with Google" / "Continue with GitHub" ----------------
#
# Both providers are OPTIONAL and configured IN PAIRS. A provider with no
# credentials simply does not appear on the sign-in page; an id without its
# secret refuses to start, because the button would render and then fail at the
# last step, after the person had already consented.
#
# PUBLIC:  GOOGLE_CLIENT_ID, GITHUB_CLIENT_ID, API_PUBLIC_URL. The client ids
#          travel in the authorize url, in the address bar.
# SECRET:  the two *_CLIENT_SECRET values. Never give either a VITE_ name --
#          Vite inlines VITE_* into the browser bundle.
#
# The FRONTEND needs nothing new at all: it never talks to a provider. The
# browser is sent to the provider by this API and comes back to this API.

# The API's own externally reachable base url -- the one a BROWSER uses, which
# is NOT always the one this process listens on:
#
#   npm run dev            http://localhost:4000/api/v1
#   docker compose up      http://localhost:3000/api/v1   <- nginx, not :4000
#
# Under compose the browser reaches the API through nginx on :3000, and nginx
# only proxies paths beginning /api/v1/. Pointing this at :4000 (or dropping
# the /api/v1 prefix) sends Google to a url that returns index.html with a 200,
# and the symptom is "the login page just reloaded".
#
# Callback urls are DERIVED from this plus a fixed path, never configured
# separately, because the redirect uri must be byte-identical in the authorize
# request, the token exchange and the provider console.
API_PUBLIC_URL=http://localhost:4000/api/v1

# Register these exact callback urls with each provider:
#   http://localhost:4000/api/v1/auth/oauth/google/callback
#   http://localhost:4000/api/v1/auth/oauth/github/callback
# Google allows several redirect uris per client, so add the :3000 pair too.
# A GitHub OAuth App allows exactly ONE, so dev and prod need separate apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# COOKIE_SAMESITE must NOT be strict while OAuth is enabled. The transaction
# cookie has to survive the provider's cross-site top-level redirect back here,
# and a Strict cookie is not sent on one -- every sign-in would fail as
# "invalid state". The cookie pins itself to lax for this reason; the setting
# above still governs the refresh cookie.

# Attachment storage. The bucket is private and never reachable from the
# browser: every read goes through GET /todos/:todoId/attachments/:id/content,
# which authorizes first and then streams.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=todo-attachments
