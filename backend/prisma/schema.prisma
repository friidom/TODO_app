model activities {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  board_id    String    @db.Uuid
  actor_id    String?   @db.Uuid
  entity_type String
  entity_id   String?   @db.Uuid
  action      String
  payload     Json      @default("{}")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  profiles    profiles? @relation(fields: [actor_id], references: [id], onUpdate: NoAction)
  boards      boards    @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([board_id, created_at(sort: Desc)], map: "activities_board_created_idx")
  @@index([board_id, entity_id], map: "activities_board_entity_idx")
  @@index([actor_id, created_at(sort: Desc)], map: "activities_actor_created_idx")
  @@index([created_at(sort: Desc)], map: "activities_created_idx")
}

