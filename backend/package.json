{
  "name": "todo-app-backend",
  "version": "1.0.0",
  "description": "Standalone Node + Express API for the TODO/Kanban app (replaces Supabase).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:ping": "tsx src/db/ping.ts",
    "db:verify-actor": "tsx src/db/verifyWithActor.ts",
    "db:verify-errors": "tsx src/db/verifyErrors.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
